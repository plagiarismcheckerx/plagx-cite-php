{
    "name": "plagiarismcheckerx/plagx-cite",
    "description": "Free APA and MLA citation generator and reference checker for PHP: reference lists, in-text citations, BibTeX import/export, DOI to citation and duplicate reference detection. By Plagiarism Checker X.",
    "type": "library",
    "keywords": [
        "citation",
        "citation-generator",
        "apa",
        "apa-citation",
        "mla",
        "mla-citation",
        "bibliography",
        "works-cited",
        "reference-list",
        "in-text-citation",
        "bibtex",
        "doi",
        "csl-json",
        "academic-writing",
        "laravel"
    ],
    "homepage": "https://github.com/plagiarismcheckerx/plagx-cite-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Plagiarism Checker X",
            "homepage": "https://plagiarismcheckerx.com/"
        }
    ],
    "support": {
        "issues": "https://github.com/plagiarismcheckerx/plagx-cite-php/issues",
        "source": "https://github.com/plagiarismcheckerx/plagx-cite-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "ext-intl": "More accurate accent handling when matching duplicate references",
        "ext-curl": "Used for DOI lookups when available (PHP streams are used otherwise)"
    },
    "autoload": {
        "psr-4": {
            "Plagx\\Cite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plagx\\Cite\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
